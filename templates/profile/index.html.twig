{% extends 'base.html.twig' %}
{% block page_title %}Perfil{% endblock %}
{% block body %}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm text-center">
                <div class="card-body">

                    <h1 class="h3 mb-4">Perfil de Usuario</h1>

                    <div class="mb-3">
                        <span class="badge bg-primary p-2">
                            {{ app.user.email }}
                        </span>
                    </div>

                    <hr>
                    <div class="mt-4">
                        <h4>Seguridad de la cuenta</h4>
                        <p class="text-muted">Protege tu cuenta con la verificación en dos pasos (2FA).</p>

                        <a href="{{ path('app_2fa_activar') }}" class="btn btn-warning">
                             Configurar Doble Factor (2FA)
                        </a>
                    </div>

                    <div class="d-grid">
                        <a href="{{ path('app_logout') }}" class="btn btn-danger">
                            Cerrar sesión
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}