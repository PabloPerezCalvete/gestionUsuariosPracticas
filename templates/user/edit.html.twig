{% block body %}
    <h1>Editar Usuario</h1>

    <div style="background: #f9f9f9; padding: 20px; border: 1px solid #ddd; margin-bottom: 20px;">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            
            <div style="margin-top: 20px;">
                <button type="submit" style="background: #28a745; color: white; padding: 10px; border: none; cursor: pointer; border-radius: 4px;">
                    Actualizar Usuario
                </button>

                {# --- ESTE ES EL ENLACE QUE BUSCAS --- #}
                <a href="{{ path('app_equipo_index') }}" style="margin-left: 10px; background: #007bff; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px; display: inline-block;">
                    💻 Ir a Gestión de Equipos
                </a>
            </div>
        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_user_index') }}">Volver al listado de usuarios</a>
{% endblock %}