{% extends 'base.html.twig' %}
{% block page_title %}Usuarios{% endblock %}
{% block body %}

<div class="container mt-5">

    <div class="mb-4">
        <button class="btn btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNuevoUsuario" aria-expanded="false" aria-controls="collapseNuevoUsuario">
            <i class="fas fa-user-plus"></i> + Nuevo Usuario
        </button>
    </div>

    <div class="collapse mb-5" id="collapseNuevoUsuario">
        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="mb-4">Nuevo Usuario</h2>

                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.roles, 'Roles', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword, 'Contraseña', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.grupo, 'Grupo', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.grupo, {'attr': {'class': 'form-select'}}) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Registrar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#collapseNuevoUsuario">
                        Cancelar
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>

    <h2 class="mb-3">Usuarios Existentes</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="tabla-usuarios-server">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Roles</th>
                    <th class="no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                </tbody>
        </table>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof $ !== 'undefined' && $.fn.DataTable) {
        $('#tabla-usuarios-server').DataTable({
            "processing": true,  // Muestra el texto/indicador de "Procesando..." al cargar
            "serverSide": true,  // Activa la lógica Server-Side
            "ajax": {
                "url": "{{ path('app_user_server_side') }}", // Llama a la ruta del servicio web en tu UserController
                "type": "POST"
            },
            "columnDefs": [
                { "targets": 'no-sort', "orderable": false, "searchable": false }
            ],
            "language": {
                "url": 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            },
            "pageLength": 10,
            "lengthMenu": [5, 10, 25, 50]
        });
    }
});
</script>

{% endblock %}