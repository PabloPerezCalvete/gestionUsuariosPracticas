{% extends 'base.html.twig' %}
{% block page_title %}Usuarios{% endblock %}
{% block body %}

<div class="container mt-5">

<div class="mb-4">
    <button class="btn btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNuevoUsuario" aria-expanded="false" aria-controls="collapseNuevoUsuario">
        <i class="fas fa-user-plus"></i> + Nuevo Usuario
    </button>
</div>
    <!-- FORMULARIO NUEVO USUARIO -->
    <div class="collapse mb-5" id="collapseNuevoUsuario">
    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="mb-4">Nuevo Usuario</h2>

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.roles, 'Roles', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword, 'Contraseña', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.grupo, 'Grupo', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.grupo, {'attr': {'class': 'form-select'}}) }}
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    Registrar
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#collapseNuevoUsuario">
                    Cancelar
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>

    <!-- LISTADO DE USUARIOS -->
    <h2 class="mb-3">Usuarios Existentes</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
            {% for u in users %}
                <tr>
                    <td>{{ u.email }}</td>

                    <td>
                        {% for role in u.roles %}
                            <span class="badge bg-secondary me-1">
                                {{ role }}
                            </span>
                        {% endfor %}
                    </td>

                    <td>
                        <div class="d-flex gap-2">

                            <a href="{{ path('app_user_edit', {id: u.id}) }}"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>

                            <form method="post"
                                  action="{{ path('app_user_delete', {id: u.id}) }}"
                                  onsubmit="return confirm('¿Seguro?')">

                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">

                                <button class="btn btn-sm btn-danger">
                                    Eliminar
                                </button>
                            </form>

                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        No hay usuarios registrados
                    </td>
                </tr>
            {% endfor %}
            </tbody>

        </table>
    </div>

</div>
{% endblock %}