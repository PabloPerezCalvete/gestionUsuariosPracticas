{% extends 'base.html.twig' %}

{% block title %}Dashboard Principal{% endblock %}
{% block page_title %}Inicio{% endblock %}

{% block body %}
<div class="container mt-5">

    

    <div class="row g-4 mb-5">
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Usuarios</h6>
                        <h2 class="display-4 fw-bold mb-0">{{ total_usuarios }}</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
                <div class="card-footer bg-black bg-opacity-10 border-0 p-3">
                    <a href="{{ path('app_user_index') }}" class="text-white text-decoration-none d-flex align-items-center justify-content-between small">
                        <span>Gestionar usuarios</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-info text-dark">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Grupos</h6>
                        <h2 class="display-4 fw-bold mb-0">{{ total_grupos }}</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fas fa-folder-open"></i>
                    </div>
                </div>
                <div class="card-footer bg-black bg-opacity-10 border-0 p-3">
                    <a href="{{ path('app_grupo_index') }}" class="text-dark text-decoration-none d-flex align-items-center justify-content-between small">
                        <span>Ver todos los grupos</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Equipos</h6>
                        <h2 class="display-4 fw-bold mb-0">{{ total_equipos }}</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fas fa-laptop"></i>
                    </div>
                </div>
                <div class="card-footer bg-black bg-opacity-10 border-0 p-3">
                    <a href="{{ path('app_equipo_index') }}" class="text-white text-decoration-none d-flex align-items-center justify-content-between small">
                        <span>Ir al inventario</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3">Acciones Rápidas del Sistema</h5>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-primary px-4 py-2">
                            <i class="fas fa-user-plus me-2"></i> Administrar Usuarios
                        </a>
                        <a href="{{ path('app_grupo_index') }}" class="btn btn-outline-info  px-4 py-2">
                            <i class="fas fa-layer-group me-2"></i> Organizar Grupos
                        </a>
                        <a href="{{ path('app_equipo_index') }}" class="btn btn-outline-success px-4 py-2">
                            <i class="fas fa-plug me-2"></i> Revisar Inventario
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}