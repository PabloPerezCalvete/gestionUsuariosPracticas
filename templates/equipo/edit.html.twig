{% extends 'base.html.twig' %}

{% block title %}Editar Equipo{% endblock %}

{% block body %}
<div class="container mt-5">

    <!-- Cabecera -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4">
            Editar Equipo:
            <span class="text-muted">{{ equipo.marca }} {{ equipo.modelo }}</span>
        </h1>
        <span class="badge bg-secondary">
            ID: #{{ equipo.id }}
        </span>
    </div>

    <!-- Card formulario -->
    <div class="card shadow-sm">
        <div class="card-body">

            {{ form_start(form) }}

            <div class="row g-3">

                <div class="col-md-6">
                    {{ form_label(form.marca, 'Marca del Fabricante', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.marca, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.modelo, 'Modelo del Dispositivo', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.modelo, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.numeroSerie, 'Número de Serie (S/N)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.numeroSerie, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.tipo, 'Categoría', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.tipo, {'attr': {'class': 'form-select'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.estado, 'Estado Actual', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.estado, {'attr': {'class': 'form-select'}}) }}
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        {{ form_label(form.propietario, '👤 Usuario Asignado', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.propietario, {'attr': {'class': 'form-select'}}) }}
                    </div>
                </div>

            </div>

            <!-- Botones -->
            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Guardar Cambios
                </button>

                <a href="{{ path('app_equipo_index') }}" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

            {{ form_end(form) }}

        </div>
    </div>

    <!-- Eliminar -->
    <div class="text-center mt-4">
        <form method="post"
              action="{{ path('app_equipo_delete', {'id': equipo.id}) }}"
              onsubmit="return confirm('¿Estás totalmente seguro de eliminar este equipo?');">

            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipo.id) }}">

            <button class="btn btn-link text-danger">
                Eliminar equipo permanentemente
            </button>
        </form>
    </div>

</div>
{% endblock %}