{% extends 'base.html.twig' %}

{% block title %}Gestión de Equipos{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="mb-4">Inventario de Equipos Informáticos</h1>

    {# 🔔 Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {# 🧾 FORMULARIO #}
    <div class="card mb-5 shadow-sm">
        <div class="card-body">
            <h3 class="card-title mb-4">Registrar Nuevo Equipo</h3>

            {{ form_start(form) }}

            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.marca, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.modelo, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.numeroSerie, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.tipo, {'attr': {'class': 'form-select'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.estado, {'attr': {'class': 'form-select'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.propietario, {
                        'label': 'Asignar a Usuario',
                        'attr': {'class': 'form-select'}
                    }) }}
                </div>
            </div>

            <button class="btn btn-success mt-4">
                Guardar Equipo
            </button>

            {{ form_end(form) }}
        </div>
    </div>

    {# 📊 TABLA #}
    <h3 class="mb-3">Listado de Equipos</h3>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>S/N</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Propietario</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
            {% for e in equipos %}
                <tr>
                    <td>{{ e.marca }}</td>
                    <td>{{ e.modelo }}</td>
                    <td><code>{{ e.numeroSerie }}</code></td>
                    <td>{{ e.tipo }}</td>

                    <td>
                        <span class="badge bg-secondary">
                            {{ e.estado }}
                        </span>
                    </td>

                    <td>
                        {% if e.propietario %}
                            <span class="text-primary fw-bold">
                                {{ e.propietario.email }}
                            </span>
                        {% else %}
                            <span class="text-muted fst-italic">
                                Disponible (Stock)
                            </span>
                        {% endif %}
                    </td>

                    <td>
                        <div class="d-flex gap-2">

                            <a href="{{ path('app_equipo_edit', {id: e.id}) }}"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>

                            <form method="post"
                                  action="{{ path('app_equipo_delete', {id: e.id}) }}"
                                  onsubmit="return confirm('¿Seguro que quieres eliminar este equipo?');">

                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">

                                <button class="btn btn-sm btn-danger">
                                    Borrar
                                </button>
                            </form>

                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No hay equipos registrados en el inventario.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
            ← Volver a Gestión de Usuarios
        </a>
    </div>

</div>
{% endblock %}