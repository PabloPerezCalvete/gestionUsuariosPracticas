{% extends 'base.html.twig' %}

{% block title %}Gestión de Equipos{% endblock %}
{% block page_title %}Equipos{% endblock %}

{% block body %}

<div class="container mt-5">

    <h1 class="mb-4">Inventario de Equipos Informáticos</h1>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <button class="btn btn-success mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#contenedorNuevoEquipo" aria-expanded="false" aria-controls="contenedorNuevoEquipo">
        <i class="fas fa-plus"></i> + Nuevo Equipo
    </button>
    
    {# FORMULARIO #}
    <div class="collapse mb-4" id="contenedorNuevoEquipo">
        <div class="card card-body shadow-sm">
            <h5 class="mb-3">Registrar Equipo</h5>
            <hr>

            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.marca, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.modelo, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.numeroSerie, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.tipo, {'attr': {'class': 'form-select'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.estado, {'attr': {'class': 'form-select'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.propietario, {
                            'label': 'Asignar a Usuario',
                            'attr': {'class': 'form-select'}
                        }) }}
                    </div>
                </div> 

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Guardar Equipo
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#contenedorNuevoEquipo">
                        Cancelar
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    {# TABLA (SERVER-SIDE) #}
    <h3 class="mb-3">Listado de Equipos</h3>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="tabla-equipos-server">
            <thead class="table-dark">
                <tr>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>S/N</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Propietario</th>
                    <th class="no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
            ← Volver a Gestión de Usuarios
        </a>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof $ !== 'undefined' && $.fn.DataTable) {
        $('#tabla-equipos-server').DataTable({
            "processing": true, // Muestra el indicador de "Cargando..." al buscar o cambiar de página
            "serverSide": true, // Activa el procesamiento del lado del servidor
            "ajax": {
                "url": "{{ path('app_equipo_server_side') }}", // Dirección de la ruta que creamos en el controlador
                "type": "POST"
            },
            "columnDefs": [
                { "targets": 'no-sort', "orderable": false, "searchable": false }
            ],
            "language": {
                "url": 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            },
            "pageLength": 10,
            "lengthMenu": [5, 10, 25, 50]
        });
    }
});
</script>

{% endblock %}