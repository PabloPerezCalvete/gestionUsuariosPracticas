<form method="post" action="{{ path('app_grupo_delete', {'id': grupo.id}) }}" onsubmit="return confirm('¿Seguro que quieres eliminar este grupo?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ grupo.id) }}">
    <button class="btn btn-danger mt-3">Eliminar</button>
</form>