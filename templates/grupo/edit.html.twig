{% extends 'base.html.twig' %}

{% block page_title %}Editar Grupo{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">Editar grupo</h1>

    <div class="card p-4 shadow-sm">

        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.nombre, 'Nombre') }}
            {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.descripcion, 'Descripción') }}
            {{ form_widget(form.descripcion, {'attr': {'class': 'form-control'}}) }}
        </div>

        {# Contenedor oculto controlado por el JavaScript #}
        <div id="contenedor-original-symfony" class="d-none">
            {{ form_widget(form.users) }}
        </div>

        <div class="mb-4 mt-4">
            <label class="form-label fw-bold">Usuarios actuales en el grupo</label>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="tabla-usuarios">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario (Email)</th>
                            <th class="text-center" style="width: 150px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        </tbody>
                </table>
            </div>
        </div>

        <div class="mb-4 p-3 bg-light border rounded">
            <label for="select-agregar-usuario" class="form-label fw-bold">Añadir usuario al grupo</label>
            <div class="input-group">
                <select id="select-agregar-usuario" class="form-select">
                    <option value="">-- Selecciona un usuario para añadir --</option>
                    </select>
                <button type="button" class="btn btn-success" id="btn-añadir-usuario">Añadir</button>
            </div>
        </div>

        <hr class="my-4">

 <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-3">
            <button type="submit" class="btn btn-primary px-4 py-2 fw-bold">
                Guardar cambios
            </button>

            <a href="{{ path('app_grupo_index') }}" class="btn btn-secondary px-4 py-2">
                Volver al listado
            </a>
        </div>

       
        <div class="d-flex justify-content-center pt-2">
            {{ include('grupo/_delete_form.html.twig') }}
        </div>

        {{ form_end(form) }}

    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const contenedor = document.querySelector('#contenedor-original-symfony');
    const tablaBody = document.querySelector('#tabla-usuarios tbody');
    const selectAgregar = document.querySelector('#select-agregar-usuario');
    const btnAñadir = document.querySelector('#btn-añadir-usuario');

    function actualizarInterfaz() {
        tablaBody.innerHTML = '';
        selectAgregar.innerHTML = '<option value="">-- Selecciona un usuario para añadir --</option>';
        
        let tieneUsuariosActivos = false;

        const selectOriginal = contenedor.querySelector('select');
        if (selectOriginal) {
            Array.from(selectOriginal.options).forEach(option => {
                if (!option.value) return; 
                if (option.selected) {
                    tieneUsuariosActivos = true;
                    agregarFilaTabla(option.text, option.value);
                } else {
                    agregarOpcionSelect(option.text, option.value);
                }
            });
        } 
        
        const checkboxes = contenedor.querySelectorAll('input[type="checkbox"]');
        if (checkboxes.length > 0) {
            checkboxes.forEach(checkbox => {
                const label = contenedor.querySelector(`label[for="${checkbox.id}"]`);
                const nombreUsuario = label ? label.textContent.trim() : 'Usuario #' + checkbox.value;

                if (checkbox.checked) {
                    tieneUsuariosActivos = true;
                    agregarFilaTabla(nombreUsuario, checkbox.value);
                } else {
                    agregarOpcionSelect(nombreUsuario, checkbox.value);
                }
            });
        }

        if (!tieneUsuariosActivos) {
            tablaBody.innerHTML = `<tr><td colspan="2" class="text-center text-muted py-3">No hay usuarios en este grupo.</td></tr>`;
        }
    }

    function agregarFilaTabla(texto, valor) {
        const fila = document.createElement('tr');
        fila.innerHTML = `
            <td>${texto}</td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger btn-quitar" data-id="${valor}">
                    Sacar del grupo
                </button>
            </td>
        `;
        tablaBody.appendChild(fila);
    }

    function agregarOpcionSelect(texto, valor) {
        const opt = document.createElement('option');
        opt.value = valor;
        opt.text = texto;
        selectAgregar.appendChild(opt);
    }

    tablaBody.addEventListener('click', function (e) {
        if (e.target.classList.contains('btn-quitar')) {
            const idUsuario = e.target.getAttribute('data-id');
            const selectOriginal = contenedor.querySelector('select');
            if (selectOriginal) {
                const opt = selectOriginal.querySelector(`option[value="${idUsuario}"]`);
                if (opt) opt.selected = false;
            }
            const checkbox = contenedor.querySelector(`input[type="checkbox"][value="${idUsuario}"]`);
            if (checkbox) checkbox.checked = false;

            actualizarInterfaz();
        }
    });

    btnAñadir.addEventListener('click', function () {
        const idUsuario = selectAgregar.value;
        if (!idUsuario) return;

        const selectOriginal = contenedor.querySelector('select');
        if (selectOriginal) {
            const opt = selectOriginal.querySelector(`option[value="${idUsuario}"]`);
            if (opt) opt.selected = true;
        }
        const checkbox = contenedor.querySelector(`input[type="checkbox"][value="${idUsuario}"]`);
        if (checkbox) checkbox.checked = true;

            actualizarInterfaz();
    });

    actualizarInterfaz();
});
</script>
{% endblock %}