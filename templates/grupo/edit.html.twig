{% extends 'base.html.twig' %}

{% block page_title %}Editar Grupo{% endblock %}

{% block body %}

<div class="container mt-4">

    <h1 class="mb-4">Editar grupo</h1>

    <div class="card p-4 shadow-sm">

        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.nombre, 'Nombre') }}
            {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.descripcion, 'Descripción') }}
            {{ form_widget(form.descripcion, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.users, 'Usuarios del grupo') }}
            {{ form_widget(form.users, {'attr': {'class': 'form-select'}}) }}
            <small class="text-muted">Puedes seleccionar varios usuarios</small>
        </div>

        <button class="btn btn-primary">
            Guardar cambios
        </button>

        {{ form_end(form) }}

    </div>

    <div class="mt-3 d-flex gap-2">
        <a href="{{ path('app_grupo_index') }}" class="btn btn-secondary">
            Volver al listado
        </a>

        {{ include('grupo/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}