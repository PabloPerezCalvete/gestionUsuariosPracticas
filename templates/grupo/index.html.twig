{% extends 'base.html.twig' %}

{% block page_title %}Grupos{% endblock %}

{% block body %}
<div class="container mt-4">

    <button class="btn btn-success mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#contenedorNuevoGrupo" aria-expanded="false" aria-controls="contenedorNuevoGrupo">
        <i class="fas fa-plus"></i> + Nuevo Grupo
    </button>

    <div class="collapse mb-4" id="contenedorNuevoGrupo">
        <div class="card card-body shadow-sm">
            <h5 class="mb-3">Registrar Nuevo Grupo</h5>
            <hr>
            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_widget(form) }}
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Guardar Grupo
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#contenedorNuevoGrupo">
                        Cancelar
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle" id="tabla-grupos-server">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Usuarios en el Grupo</th>
                    <th class="no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                </tbody>
        </table>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof $ !== 'undefined' && $.fn.DataTable) {
        $('#tabla-grupos-server').DataTable({
            "processing": true, // Muestra indicador de carga
            "serverSide": true, // Activa el procesamiento en servidor
            "ajax": {
                "url": "{{ path('app_grupo_server_side') }}", // Servicio web de grupos
                "type": "POST"
            },
            "columnDefs": [
                { "targets": 'no-sort', "orderable": false, "searchable": false }
            ],
            "language": {
                "url": 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            },
            "pageLength": 10,
            "lengthMenu": [5, 10, 25, 50]
        });
    }
});
</script>
{% endblock %}