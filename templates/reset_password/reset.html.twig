{% extends 'base.html.twig' %}

{% block title %}Cambiar tu contraseña{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Restablecer nueva contraseña</h1>

        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword, {
                'label': 'Nueva contraseña'
            }) }}
            
            <button class="btn btn-success mt-3">Guardar nueva contraseña</button>
        {{ form_end(resetForm) }}
    </div>
{% endblock %}