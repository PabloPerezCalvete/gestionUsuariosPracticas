<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}App{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            /* 💻 Ajustado para cambiar de color automáticamente */
            background-color: var(--bs-body-bg);
            color: var(--bs-body-color);
        }

        /* SIDEBAR */
        .sidebar {
            /* 💻 Ajustado para que el fondo se vuelva oscuro solo */
            background-color: var(--bs-tertiary-bg);
            position: fixed;
            top: 0;
            left: 0;
            width: 240px;
            height: 100vh;
            overflow-y: auto;
            border-right: 1px solid var(--bs-border-color);
            transition: width 0.3s ease;
        }

        /* SIDEBAR CERRADA */
        .sidebar.collapsed {
            width: 0;
            overflow: hidden;
            padding: 0;
        }

        .sidebar-title {
            color: var(--bs-heading-color);
            font-weight: 600;
            padding: 10px 15px; /* Añadido padding para que no se pegue al borde */
        }

        .sidebar .nav-link {
            color: var(--bs-nav-link-color);
            padding: 10px 15px;
            border-radius: 4px;
            margin-bottom: 3px;
            font-size: 0.9rem;
        }

        .sidebar .nav-link:hover {
            background-color: var(--bs-tertiary-color);
            color: var(--bs-heading-color);
        }

        .sidebar .nav-link.active {
            background-color: var(--bs-primary-border-subtle);
            color: var(--bs-primary-text-emphasis);
            font-weight: 500;
        }

        .sidebar hr {
            border-color: var(--bs-border-color);
        }

        .user-link {
            color: white; /* Forzado a blanco porque la topbar es naranja fija */
            text-decoration: none;
            padding: 8px 15px;
            display: block;
        }

        .user-link:hover {
            color: #eee;
        }

        /* TOPBAR (Mantiene su color corporativo naranja en ambos modos) */
        .topbar {
            background-color: #f58220;
            color: white;
            padding: 15px;
            font-weight: bold;
            text-align: center;
            position: relative;
        }

        /* BOTÓN */
        .toggle-btn {
            position: absolute;
            left: 15px;
            top: 10px;
            background: transparent;
            border: none;
            color: white;
            font-size: 22px;
            cursor: pointer;
        }

        /* CONTENIDO */
        .main-content {
            margin-left: 240px;
            transition: margin-left 0.3s ease;
        }

        /* CUANDO SIDEBAR ESTÁ CERRADA */
        .main-content.full {
            margin-left: 0;
        }

        .content {
            padding: 20px;
        }
    </style>
</head>

<body>

<nav id="sidebar" class="sidebar">
    <div class="pt-3">
        <h4 class="sidebar-title">Gestión usuarios</h4>
    </div>
    <hr>

    <ul class="nav flex-column px-2">
        {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item">
                <a href="{{ path('app_equipo_index') }}" 
                   class="nav-link {{ app.request.get('_route') starts with 'app_equipo' ? 'active' }}">
                    Equipos
                </a>
            </li>

            <li class="nav-item">
                <a href="{{ path('app_user_index') }}" 
                   class="nav-link {{ app.request.get('_route') starts with 'app_user' ? 'active' }}">
                    Usuarios
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_grupo_index') }}" 
                   class="nav-link {{ app.request.get('_route') starts with 'app_grupo' ? 'active' }}">
                    Grupos
                </a>
            </li>
        {% endif %}
        <hr>
    </ul>
</nav>

<div id="main" class="main-content">

<div class="topbar d-flex align-items-center justify-content-between px-3">

    <div class="d-flex align-items-center">
        <button class="toggle-btn me-3" onclick="toggleSidebar()">
            ☰
        </button>
        <div class="text-center" style="position: absolute; left: 50%; transform: translateX(-50%); width: auto; z-index: 1;">
            <span class="h5 mb-0">
                {% block page_title %}Inicio{% endblock %}
            </span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2" style="z-index: 2;">
        
        <button class="btn btn-sm btn-link text-white text-decoration-none me-2" id="btn-theme-toggle" type="button" title="Cambiar tema">
            <span id="theme-icon">🌙</span>
        </button>

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <span class="nav-item">
                <a href="{{ path('app_user_profile') }}" class="user-link text-decoration-none p-0 fw-bold">
                    {{ app.user.userIdentifier }}
                </a>
            </span>

            <span class="nav-item ms-2">
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-light">
                    Logout
                </a>
            </span>
        {% else %}
            <span class="nav-item">
                <a href="{{ path('app_login') }}" class="nav-link text-white">
                    Login
                </a>
            </span>
        {% endif %}
    </div>

</div>

    <div class="content">
        {% block body %}{% endblock %}
    </div>

</div>

<script>
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const main = document.getElementById('main');

    sidebar.classList.toggle('collapsed');
    main.classList.toggle('full');
}

// LÓGICA DE MODO OSCURO / CLARO
document.addEventListener('DOMContentLoaded', function () {
    const htmlElement = document.documentElement;
    const themeBtn = document.getElementById('btn-theme-toggle');
    const themeIcon = document.getElementById('theme-icon');

    // 1. Cargamos el tema guardado en el usuario de Symfony directamente desde la base de datos
    // Si el campo está vacío o el usuario no está logueado, por defecto ponemos 'light'
    const temaGuardado = "{{ (app.user and app.user.theme) ? app.user.theme : 'light' }}";
    aplicarTema(temaGuardado);

    // 2. Escuchar el click en el símbolo (☼ / ☾)
    themeBtn.addEventListener('click', function () {
        const temaActual = htmlElement.getAttribute('data-bs-theme');
        const nuevoTema = (temaActual === 'dark') ? 'light' : 'dark';
        
        // Cambiamos el color de la pantalla inmediatamente para que no haya retraso visual
        aplicarTema(nuevoTema);

        // 3. Enviamos el cambio al servidor por detrás (solo si el usuario ha iniciado sesión)
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            fetch("{{ path('app_user_update_theme') }}", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ theme: nuevoTema })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) console.error('Error del servidor:', data.error);
            })
            .catch(error => console.error('Error en la petición fetch:', error));
        {% endif %}
    });

    // Función que pinta el símbolo y cambia el modo de Bootstrap 5
    function aplicarTema(tema) {
        htmlElement.setAttribute('data-bs-theme', tema);

        if (tema === 'dark') {
            themeIcon.textContent = '☼';
            themeIcon.style.fontSize = '28px';
            themeIcon.style.color = '#000000';
        } else {
            themeIcon.textContent = '☾';
            themeIcon.style.fontSize = '28px';
            themeIcon.style.color = '#000000';
        }
    }
});
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.7/js/dataTables.bootstrap5.min.js"></script>

</body>
</html>