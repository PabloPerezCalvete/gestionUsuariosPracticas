{% extends 'base.html.twig' %}

{% block title %}Verificación de Seguridad (2FA){% endblock %}

{# Ponemos el título que aparecerá en tu barra superior naranja #}
{% block page_title %}Verificación 2FA{% endblock %}

{% block body %}
<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 450px;">
        <div class="text-center mb-4">
            <h2 class="h4"> Código de Seguridad</h2>
            <p class="text-muted small">Introduce el código de 6 dígitos de tu aplicación de autenticación para acceder.</p>
        </div>

        {# Mensaje si el usuario se equivoca introduciendo el código #}
        {% if authenticationError %}
            <div class="alert alert-danger p-2 small">
                {{ authenticationError|trans(authenticationErrorData, 'SecurityBundle') }}
            </div>
        {% endif %}

        <form action="{{ path('2fa_login_check') }}" method="post">
            <div class="mb-3">
                <label for="_auth_code" class="form-label small fw-bold">Código de Autenticación</label>
                <input 
                    type="text" 
                    id="_auth_code" 
                    name="_auth_code" 
                    autocomplete="one-time-code" 
                    inputmode="numeric" 
                    pattern="[0-9]*" 
                    class="form-control form-control-lg text-center fw-bold" 
                    placeholder="000000" 
                    required 
                    autofocus
                >
            </div>
           {# <div class="mb-3 form-check">
                <input type="checkbox" id="_trusted" name="_trusted" class="form-check-input">
                <label for="_trusted" class="form-check-label small text-muted">Confiar en este dispositivo durante 30 días</label>
            </div>
            #}
            <button class="btn w-100 text-white fw-bold" style="background-color: #f58220;" type="submit">Verificar y Entrar</button>
        </form>

        <div class="text-center mt-3">
            <a href="{{ path('app_logout') }}" class="text-muted small text-decoration-none"><h3>Cancelar e ir al Login</h3></a>
        </div>
    </div>
</div>
{% endblock %}