{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}
{% block page_title %}Registrarse{% endblock %}

{% block body %}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h1 class="h3 mb-4 text-center">Crear cuenta</h1>

                    {{ form_start(registrationForm) }}

                    {% if form_errors(registrationForm) %}
                        <div class="alert alert-danger">
                            {{ form_errors(registrationForm) }}
                        </div>
                    {% endif %}

                    <div class="mb-3">
                        {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.plainPassword, 'Contraseña', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="form-check mb-3">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Registrarse
                        </button>
                    </div>

                    {{ form_end(registrationForm) }}

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}